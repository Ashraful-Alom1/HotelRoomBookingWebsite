{
  "rules": {
    "rooms": {
      ".read": true,
      ".write": "auth != null && (auth.token.role === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
    },
    "bookings": {
      "$bookingId": {
        ".read": "auth != null && (auth.token.role === 'ADMIN' || data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".write": "auth != null && (auth.token.role === 'ADMIN' || !data.exists() || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
      }
    },
    "reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "auth != null && (auth.token.role === 'ADMIN' || !data.exists() || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.role === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
    }
  }
}
